# ==============================================================================
# MoTA Scholarship & Fellowship OS - Environment Template
# Copy to .env and fill in your values. NEVER commit .env to Git.
# ==============================================================================

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mota_scholarship
DB_USERNAME=root
DB_PASSWORD=

# Production Database URL (for Render / managed MySQL — overrides individual DB vars)
# DATABASE_URL=jdbc:mysql://host:3306/dbname?useSSL=true&serverTimezone=UTC

# JWT Security (generate a strong 256-bit hex secret)
JWT_SECRET=
JWT_EXPIRATION=86400000
REFRESH_TOKEN_EXPIRATION=604800000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Storage Path (relative or absolute path)
FILE_STORAGE_PATH=uploads

# OpenAI (optional — AI features degrade gracefully when blank)
OPENAI_API_KEY=

# Tesseract OCR Path (leave as 'tesseract' for Linux/Render; set to local exe for Windows)
TESSERACT_PATH=tesseract

# Mail Configuration (for OTP / notifications)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# OTP Expiration (minutes)
OTP_EXPIRATION_MINUTES=10

# Mock Integrations (true for demo mode)
MOCK_INTEGRATIONS=true